{
  "mcpServers": {
    "plugin-notes": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/servers/notes_mcp.py", "--state", "${COPILOT_PLUGIN_DATA}/notes"],
      "env": {
        "NOTES_WORKSPACE": "${NOTES_WORKSPACE:-default}"
      },
      "tools": ["search_notes", "write_note"]
    }
  }
}
