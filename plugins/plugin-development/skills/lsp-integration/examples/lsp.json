{
  "lspServers": {
    "plugin-typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    },
    "plugin-python": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "fileExtensions": {
        ".py": "python",
        ".pyw": "python",
        ".pyi": "python"
      }
    },
    "plugin-go": {
      "bash": "${PLUGIN_ROOT}/skills/lsp-integration/examples/bundled-wrapper.sh gopls",
      "fileExtensions": {
        ".go": "go"
      }
    }
  }
}
